    "validate": "node scripts/run-validation.js",
    "generate:dataset": "node scripts/generate-dataset.js",
    "test:dataset": "node test/test-dataset.js",
    "test:analog": "node scripts/test-analog-matching.js",
    "test:epe": "node scripts/test-epe.js"
  },
